# Canonical micro-eval configuration example.
# Copy this file to eval.yaml and edit local commands/tasks.
#
# Security model:
# - agent.command is an argv list, not a shell string.
# - task input is passed via stdin or an input file.
# - output file/directory paths are provided through MICRO_EVAL_OUTPUT_FILE and
#   MICRO_EVAL_OUTPUT_DIR plus the {output_file}/{output_dir} placeholders.
# - secrets should be declared as MICRO_EVAL_SECRET_* names in required_secrets
#   and provided by the process environment, not hardcoded here.

project_name: my-agent-eval
description: Compare local agent configurations on deterministic tasks.

configurations:
  - id: baseline
    name: claude-code-v1
    role: baseline
    repetitions: 1
    agent:
      name: claude-code-v1
      command: ["claude", "-p", "--output-file", "{output_file}", "--max-turns", "10"]
      input_mode: stdin
      output_mode: file
      timeout_s: 300
      env:
        ANTHROPIC_MODEL: claude-sonnet-4-20250514
      required_secrets:
        - MICRO_EVAL_SECRET_ANTHROPIC_API_KEY

  - id: candidate
    name: claude-code-v2
    role: candidate
    repetitions: 1
    agent:
      name: claude-code-v2
      command: ["claude", "-p", "--output-file", "{output_file}", "--max-turns", "20"]
      input_mode: stdin
      output_mode: file
      timeout_s: 300
      env:
        ANTHROPIC_MODEL: claude-sonnet-4-20250514
      required_secrets:
        - MICRO_EVAL_SECRET_ANTHROPIC_API_KEY

tasks:
  - tasks/hello.yaml
output_dir: .micro-eval/runs

guardrails:
  max_concurrency: 2
  timeout_s: 300
  output_cap_bytes: 10485760
  artifact_cap_bytes: 10485760
  stop_on_cell_error: false

evaluation:
  comparison_subject: "candidate agent config vs baseline"
  task_set_version: ""
  success_criteria:
    - Deterministic validator expectations pass.
    - Human evaluator reviews caveats before making a decision.
  budget: null
  decision_threshold: null
  inconclusive_policy: warn
  min_repetitions: 1
  required_evaluators: [validator]
  denominator_policy: include_failed

# Optional trace capture. Keep disabled unless you have configured the provider.
trace:
  enabled: false
  provider: process  # process | langfuse

# Optional supplemental LLM judge. Does not override deterministic validation.
judge:
  enabled: false
  provider: deepeval
  model: ""
  temperature: 0.0
  pass_threshold: 0.5
  required_secrets: []
