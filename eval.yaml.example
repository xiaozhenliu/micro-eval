# micro-eval 配置示例
# 复制为 eval.yaml 并根据你的项目自定义。
#
# 环境变量说明：
#   agent 的 env 字段会**合并**到当前系统环境变量中（不是替换）。
#   所以 PATH、HOME 等系统变量始终可用。
#   建议：敏感信息（API key）通过系统环境变量或 .env 设置，
#   eval.yaml 中用 ${VAR_NAME} 引用（当前版本直接传字符串，不做变量展开）。

project_name: my-agent-eval
description: 对比 coding agent 在 bug-fix 任务上的表现

baseline:
  name: claude-code-v1
  command: "claude -p --output-file {output_dir}/result.txt --max-turns 10"
  input_mode: stdin          # stdin | file
  output_mode: file          # stdout | file | directory
  timeout_s: 300
  env:
    ANTHROPIC_API_KEY: sk-ant-xxx       # 替换为你的 key
    ANTHROPIC_MODEL: claude-sonnet-4-20250514

candidate:
  name: claude-code-v2
  command: "claude -p --output-file {output_dir}/result.txt --max-turns 20"
  input_mode: stdin
  output_mode: file
  timeout_s: 300
  env:
    ANTHROPIC_API_KEY: sk-ant-xxx
    ANTHROPIC_MODEL: claude-sonnet-4-20250514

# --- 更多 agent 类型示例 ---

